---
// レイアウトコンポーネント (BlogPostLayout.astro)
import Header from '../components/Header.astro'; // ← Headerコンポーネントをインポート
import Footer from '../components/Footer.astro'; // (例：フッターもコンポーネント化している場合)
// Markdownファイルのフロントマターからデータを受け取る
import '../styles/global.css'; // ← この行を追加してCSSファイルを読み込む
// frontmatter ではなく、直接 title を受け取る
const { title } = Astro.props;
---
<html lang="ja">
<head>
    <meta charset="utf-8" /> {/* ← 重要: 文字化けを防ぐために必ず記述 */}
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> {/* typeを指定 */}

    <title>{title}</title> {/* Markdownのタイトルを表示 */}
</head>
  <body class="flex flex-col min-h-screen"> {/* Tailwindでフッターを最下部に固定する例 */}
    <Header /> {/* 例:共通ヘッダー */}
    <main>
        <h1>{title}</h1> {/* Markdownのタイトルを表示 */}
        <article>
            <slot /> {/* ← ここにMarkdown本文の内容が挿入される */}
        </article>
    </main>
<Footer /> {/* 例：フッターコンポーネント */}
</body>
</html>
